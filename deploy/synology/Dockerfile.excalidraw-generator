FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY deploy/synology/requirements-excalidraw-lock.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir --requirement /app/requirements.txt
COPY excalidraw_generator /app/excalidraw_generator

EXPOSE 8090
CMD ["python", "-m", "uvicorn", "excalidraw_generator.api:app", "--host", "0.0.0.0", "--port", "8090"]
